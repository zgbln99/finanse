# ---- Database ----
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=cockpit
POSTGRES_DB=cockpit
DATABASE_URL=postgresql://cockpit:cockpit@postgres:5432/cockpit?schema=public

# ---- Redis / Queue ----
REDIS_URL=redis://redis:6379

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ---- AI review ----
# Documents with overall confidence below this go into the manual review queue.
AI_CONFIDENCE_THRESHOLD=0.8

# ---- Ingestion ----
# Folder watched for new PDFs. Mount a local dir or an rclone Google Drive here.
INGEST_DIR=/data/inbox
STORAGE_DIR=/data/storage
OCR_LANG=deu+eng

# ---- rclone (Google Drive auto-sync) ----
# Put your rclone.conf into ./rclone/ first. Drive layout: RCLONE_BASE/<year>.
RCLONE_REMOTE=gdrive
RCLONE_BASE=Rechnungen
RCLONE_INTERVAL=300
# Set only to re-import a past archive year once (e.g. 2025), then unset again.
RCLONE_YEAR=

# ---- Business constant ----
# This company is ALWAYS the customer (Kunde), never the vendor.
OWN_COMPANY_NAME=LTS Logistik GmbH

# ---- KW-Kontrolle (dual sign-off by the two managing directors) ----
# Names shown in the KW approval columns.
GF1_NAME=Geschäftsführung 1
GF2_NAME=Geschäftsführung 2
